[app]
title = Primary School Panauta
package.name = pspanauta
package.domain = org.panauta
source.dir = .
source.include_exts = py,png,jpg,jpeg,kv,ttf,xlsx
version = 1.0
requirements = python3,kivy,et-xmlfile,openpyxl,charset-normalizer,reportlab,pillow,plyer,android
icon.filename = %(source.dir)s/logo.png
orientation = landscape
fullscreen = 0
android.permissions = INTERNET,WRITE_EXTERNAL_STORAGE,READ_EXTERNAL_STORAGE,CAMERA
android.api = 33
android.ndk = 25b
android.minapi = 24
android.archs = arm64-v8a
p4a.local_recipes = ./p4a_recipes
p4a.branch = release-2024.01.21
android.accept_sdk_license = True
